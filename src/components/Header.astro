---
const links = [
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/" aria-label="Nextmarg home">
      <img src="/brand/nextmarg-logo-primary.svg" alt="Nextmarg" width="130" height="34" />
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a class="btn header-cta" href="/digital-health-score"><span class="dot" aria-hidden="true"></span>Free Digital Health Score</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
  <div class="wrap mobile-nav" id="mobile-nav">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a class="btn" href="/digital-health-score"><span class="dot" aria-hidden="true"></span>Free Digital Health Score</a>
  </div>
</header>

<script is:inline>
  (function () {
    var t = document.querySelector('.menu-toggle');
    var m = document.getElementById('mobile-nav');
    t.addEventListener('click', function () {
      var open = m.classList.toggle('open');
      t.setAttribute('aria-expanded', open ? 'true' : 'false');
      t.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  })();
</script>
