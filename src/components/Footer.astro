---
import { site, whatsappLink } from '../data/site';
import { groups } from '../data/services';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <img src="/brand/nextmarg-logo-reversed.svg" alt="Nextmarg" width="150" height="40" style="height:40px;width:auto;margin-bottom:16px" />
        <p style="color:rgba(246,242,234,.85);max-width:320px">{site.tagline} Founder-led digital agency in {site.city}, India.</p>
      </div>
      <div>
        <h3>Services</h3>
        <ul>
          {groups.map((g) => <li><a href={`/services#${g.id}`}>{g.title}</a></li>)}
          <li><a href="/services/seo-ai-search">SEO and AI search</a></li>
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/digital-health-score">Digital Health Score</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/guides">Guides</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy notice</a></li>
          <li><button class="link-btn" type="button" data-open-consent>Cookie settings</button></li>
        </ul>
      </div>
      <div>
        <h3>Talk to us</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><a href={whatsappLink} target="_blank" rel="noopener">WhatsApp</a></li>
          {site.googleBusinessProfile && <li><a href={site.googleBusinessProfile} target="_blank" rel="noopener">Find us on Google</a></li>}
          <li style="color:rgba(246,242,234,.7)">{site.city}, {site.region}, India</li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>© {year} Nextmarg. All rights reserved.</span>
      <span>Your accounts, domain and data always stay in your name.</span>
    </div>
  </div>
</footer>
