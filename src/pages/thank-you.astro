---
import Base from '../layouts/Base.astro';
import { whatsappLink } from '../data/site';
---

<Base title="Thank you" description="Thanks for getting in touch with Nextmarg." noindex>
  <section class="page-hero" style="min-height:60vh">
    <div class="wrap" style="max-width:760px">
      <span class="kicker">Received</span>
      <h1 class="display">Thank you. Your next step is on its way.</h1>
      <p class="lead">We'll message you on WhatsApp or email within one working day. If it's urgent, chat with us now.</p>
      <div class="actions">
        <a class="btn" href={whatsappLink} target="_blank" rel="noopener">Chat on WhatsApp</a>
        <a class="btn btn--ghost" href="/services">Browse services</a>
      </div>
    </div>
  </section>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lead_thank_you' });
  </script>
</Base>
