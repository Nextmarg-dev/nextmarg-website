---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="page-hero" style="min-height:60vh">
    <div class="wrap" style="max-width:760px">
      <span class="kicker">404</span>
      <h1 class="display">This path doesn't lead anywhere</h1>
      <p class="lead">The page may have moved. Here are the best places to go next.</p>
      <div class="actions">
        <a class="btn" href="/">Home</a>
        <a class="btn btn--ghost" href="/services">Services</a>
        <a class="btn btn--ghost" href="/digital-health-score">Free Digital Health Score</a>
      </div>
    </div>
  </section>
</Base>
